{
  "manifest_version": 3,
  "name": "Developer Task Manager",
  "description": "Manage and track developer tasks in a compact Chrome extension dashboard.",
  "version": "1.0.0",
  "permissions": ["storage", "alarms", "notifications"],
  "action": {
    "default_title": "Developer Task Manager",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
